<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><NuGetAudit>false</NuGetAudit>
    <RestoreAdditionalProjectSources>$(R3PackageSource)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="W.DamengProvider" Version="[$(R3PackageVersion)]" /></ItemGroup>
  <Target Name="RequirePackage" BeforeTargets="CollectPackageReferences;CoreCompile">
    <Error Condition="'$(R3PackageVersion)' == '' or '$(R3PackageSource)' == ''" Text="An exact package version and source are required." />
  </Target>
</Project>
