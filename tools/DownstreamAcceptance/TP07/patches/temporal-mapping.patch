+using System.Globalization;
+using System.Numerics;
+using System.Text.RegularExpressions;
+
+namespace W.EntityFrameworkCore.Dameng.Storage.Internal;
+
+// Model precision stays on the mapping. Parameter Scale alone is fractional seconds;
+// no connection/profile lookup or new driver capability is introduced here.
+internal static class DamengTemporalParameterFacets
+{
+    internal static int Fraction(int? configured, int maximum, int fallback = 6)
+    {
+        var fraction = configured ?? fallback;
+        if (fraction < 0 || fraction > maximum)
+            throw new InvalidOperationException("Temporal fractional precision is outside the mapping range.");
+        return fraction;
+    }
+
+    internal static long PowerOfTen(int exponent)
+    {
+        var value = 1L;
+        for (var index = 0; index < exponent; index++) value *= 10;
+        return value;
+    }
+
+    internal static void ExactTicks(long ticks, int fraction)
+    {
+        if (fraction < 7 && ticks % PowerOfTen(7 - fraction) != 0)
+            throw new OverflowException("Temporal value cannot be represented at the declared fractional precision.");
+    }
+
+    internal static void Midnight(DateTime value)
+    {
+        if (value.TimeOfDay.Ticks != 0)
+            throw new OverflowException("DATE cannot represent clock fields.");
+    }
+
+    internal static void RejectLocalTimezoneLiteral(string storeType)
+    {
+        // Registry and public clones both carry this semantic store type. A literal
+        // has no fixed-mask parameter gate, so reject before rendering any value.
+        if (Regex.IsMatch(storeType,
+            @"^\s*(?:TIMESTAMP|DATETIME2|DATETIME|SMALLDATETIME)(?:\s*\(\s*\d+\s*\))?\s+WITH\s+LOCAL\s+TIME\s+ZONE\s*$",
+            RegexOptions.IgnoreCase | RegexOptions.CultureInvariant))
+            throw new NotSupportedException("Local timezone temporal literal writes are not verified.");
+    }
+
+    internal static string TimestampLiteral(DateTime value, int fraction, TimeSpan? offset = null)
+    {
+        if (fraction > 7)
+            throw new NotSupportedException("Eight and nine digit temporal literal writes are not verified.");
+        LiteralDomain(value, offset);
+        ExactTicks(value.Ticks, fraction);
+        var clock = value.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
+        if (fraction > 0)
+            clock += "." + (value.Ticks % TimeSpan.TicksPerSecond).ToString("D7", CultureInfo.InvariantCulture)[..fraction];
+        if (offset is { } zone)
+        {
+            var minutes = checked((int)(zone.Ticks / TimeSpan.TicksPerMinute));
+            if (fraction == 7) clock += " ";
+            clock += FormattableString.Invariant($"{(minutes < 0 ? "-" : "+")}{Math.Abs(minutes) / 60:D2}:{Math.Abs(minutes) % 60:D2}");
+        }
+        if (fraction == 7)
+            return offset.HasValue
+                ? $"TO_TIMESTAMP_TZ('{clock}', 'YYYY-MM-DD HH24:MI:SS.FF7 TZH:TZM')"
+                : $"TO_TIMESTAMP('{clock}', 'YYYY-MM-DD HH24:MI:SS.FF7')";
+        return $"TIMESTAMP '{clock}'";
+    }
+
+    internal static void LiteralDomain(DateTime value, TimeSpan? offset = null)
+    {
+        if (value.Year == 1582 && value.Month == 10 && value.Day is >= 5 and <= 14)
+            throw new NotSupportedException("Temporal literal is in an unverified calendar transform region.");
+        // TP06 accepted W write contract: offset minutes [-779,840], not a claim
+        // about every server. SQL literal preservation still has its own real gate.
+        if (offset is { } zone && zone.Ticks / TimeSpan.TicksPerMinute is < -779 or > 840)
+            throw new OverflowException("Temporal literal offset exceeds the supported server range.");
+    }
+
+    internal static void IntervalLeading(TimeSpan value, int leading)
+    {
+        if (leading is < 1 or > 9)
+            throw new InvalidOperationException("INTERVAL leading precision must be between one and nine.");
+        var days = BigInteger.Abs(new BigInteger(value.Ticks)) / TimeSpan.TicksPerDay;
+        if (days >= PowerOfTen(leading))
+            throw new OverflowException("INTERVAL day component exceeds its declared leading precision.");
+    }
+}
