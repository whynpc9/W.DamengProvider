+#pragma warning disable EF1001
+using System.Data;
+using System.Reflection;
+using System.Security.Cryptography;
+using System.Text.Json;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Infrastructure;
+using Microsoft.EntityFrameworkCore.Storage;
+using W.Dm;
+using W.EntityFrameworkCore.Dameng.Storage.Internal;
+using Xunit;
+
+namespace W.EntityFrameworkCore.Dameng.Tests;
+
+public sealed class TP07TemporalMappingTests
+{
+    internal static DbContext Context()
+    {
+        CandidateIdentity();
+        return new DbContext(new DbContextOptionsBuilder().UseDameng(new DmConnection(), contextOwnsConnection: true).Options);
+    }
+    private static void CandidateIdentity()
+    {
+        var driver = typeof(DmConnection).Assembly;
+        Assert.Equal("aa23e673-957c-4b1e-bf0f-291ff60077e6", driver.ManifestModule.ModuleVersionId.ToString());
+        Assert.Equal("843710bec351b65aa075cd917bb352a525fdbc6e1a6e1396eeaae46dc8946980",
+            Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(driver.Location))).ToLowerInvariant());
+        using var deps = JsonDocument.Parse(File.ReadAllText(Path.ChangeExtension(typeof(TP07TemporalMappingTests).Assembly.Location, ".deps.json")));
+        var libraries = deps.RootElement.GetProperty("libraries");
+        Assert.Equal("package", libraries.GetProperty("W.DamengProvider/0.1.0-temporal.20261008144915").GetProperty("type").GetString());
+        Assert.True(libraries.TryGetProperty("Microsoft.EntityFrameworkCore.Relational/10.0.12", out _));
+        Assert.DoesNotContain(libraries.EnumerateObject(), item => item.Name.StartsWith("DM.DmProvider/", StringComparison.OrdinalIgnoreCase));
+    }
+    internal static IRelationalTypeMappingSource Source(DbContext context) => context.GetService<IRelationalTypeMappingSource>();
+
+    [Theory]
+    [InlineData(false)] [InlineData(true)]
+    public void DefaultsTransferFractionButKeepObservedUnsetPrecision(bool isNull)
+    {
+        using var context = Context(); using var command = new DmCommand();
+        var source = Source(context);
+        foreach (var type in new[] { typeof(DateTime), typeof(DateTimeOffset), typeof(TimeOnly), typeof(TimeSpan) })
+        {
+            var mapping = source.FindMapping(type)!;
+            object value;
+            if (type == typeof(DateTime)) value = new DateTime(2026, 7, 23);
+            else if (type == typeof(DateTimeOffset)) value = new DateTimeOffset(2026, 7, 23, 0, 0, 0, TimeSpan.FromHours(8));
+            else if (type == typeof(TimeOnly)) value = TimeOnly.MinValue;
+            else value = TimeSpan.Zero;
+            var parameter = Assert.IsType<DmParameter>(mapping.CreateParameter(command, "p", isNull ? null : value, nullable: true));
+            Assert.Equal((byte)(type == typeof(DateTime) || type == typeof(DateTimeOffset) ? 7 : 6), parameter.Scale);
+            Assert.Equal((byte)0, parameter.Precision);
+            Assert.False(Explicit(parameter, "m_SetPrecFlag"));
+            Assert.True(Explicit(parameter, "m_SetScaleFlag"));
+            if (type == typeof(TimeSpan)) Assert.Equal(DmDbType.IntervalDayToSecond, parameter.DmSqlType);
+        }
+        var decimalMapping = source.FindMapping(typeof(decimal), null, precision: 12, scale: 2)!;
+        var number = decimalMapping.CreateParameter(command, "d", 12.34m);
+        Assert.Equal((byte)12, number.Precision); Assert.Equal((byte)2, number.Scale);
+    }
+
+    [Theory]
+    [InlineData(0)] [InlineData(3)] [InlineData(6)] [InlineData(7)] [InlineData(8)] [InlineData(9)]
+    public void TimestampFacetsNullAndClonesKeepFractionAndSubclass(int fraction)
+    {
+        using var context = Context(); using var command = new DmCommand();
+        foreach (var type in new[] { typeof(DateTime), typeof(DateTimeOffset) })
+        {
+            var mapping = Source(context).FindMapping(type, null, precision: fraction)!;
+            var clone = mapping.WithPrecisionAndScale(fraction, null);
+            Assert.Equal(mapping.GetType(), clone.GetType()); Assert.Equal(fraction, clone.Precision);
+            foreach (object? value in new object?[] { null, type == typeof(DateTime) ? (object)new DateTime(2026, 7, 23) : new DateTimeOffset(2026, 7, 23, 0, 0, 0, TimeSpan.Zero) })
+            {
+                var parameter = clone.CreateParameter(command, "p", value, nullable: true);
+                Assert.Equal((byte)fraction, parameter.Scale); Assert.Equal((byte)0, parameter.Precision);
+                Assert.Equal(type == typeof(DateTime) ? DbType.DateTime2 : DbType.DateTimeOffset, parameter.DbType);
+            }
+        }
+        // 8/9 are metadata/parameter declaration controls, not successful write evidence.
+    }
+
+    [Fact]
+    public void ParameterQuantumIsCheckedBeforeAnyValueCouldBeLost()
+    {
+        using var context = Context(); using var command = new DmCommand(); var source = Source(context);
+        var dt = new DateTime(2026, 7, 23).AddTicks(1);
+        var dto = new DateTimeOffset(dt, TimeSpan.Zero);
+        var six = source.FindMapping(typeof(DateTime), null, precision: 6)!;
+        Assert.Throws<OverflowException>(() => six.CreateParameter(command, "p", dt));
+        Assert.Throws<OverflowException>(() => source.FindMapping(typeof(DateTimeOffset), null, precision: 6)!.CreateParameter(command, "p", dto));
+        Assert.Equal(dt, source.FindMapping(typeof(DateTime))!.CreateParameter(command, "p", dt).Value);
+        Assert.Equal(dto, source.FindMapping(typeof(DateTimeOffset))!.CreateParameter(command, "p", dto).Value);
+        var clone = source.FindMapping(typeof(DateTime))!.WithPrecisionAndScale(6, null);
+        Assert.IsType<DamengDateTimeTypeMapping>(clone);
+        Assert.Throws<OverflowException>(() => clone.CreateParameter(command, "p", dt));
