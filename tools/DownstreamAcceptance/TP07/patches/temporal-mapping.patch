+using System.Data;
+using System.Data.Common;
+using System.Globalization;
+using Microsoft.EntityFrameworkCore.Storage;
+
+namespace W.EntityFrameworkCore.Dameng.Storage.Internal;
+
+internal sealed class DamengDateTimeTypeMapping : DateTimeTypeMapping
+{
+    public DamengDateTimeTypeMapping(string storeType, DbType dbType = System.Data.DbType.DateTime2)
+        : base(storeType, dbType) { }
+
+    private DamengDateTimeTypeMapping(RelationalTypeMappingParameters parameters) : base(parameters) { }
+
+    protected override RelationalTypeMapping Clone(RelationalTypeMappingParameters parameters)
+        => new DamengDateTimeTypeMapping(parameters);
+
+    private bool IsDate => DbType == System.Data.DbType.Date;
+    private int Fraction
+    {
+        get
+        {
+            if (!IsDate) return DamengTemporalParameterFacets.Fraction(Precision, 9);
+            if (Precision is not null and not 0)
+                throw new InvalidOperationException("DATE has no fractional precision facet.");
+            return 0;
+        }
+    }
+
+    protected override void ConfigureParameter(DbParameter parameter)
+    {
+        var fraction = Fraction;
+        if (parameter.Value is DateTime value)
+        {
+            if (IsDate) DamengTemporalParameterFacets.Midnight(value);
+            else DamengTemporalParameterFacets.ExactTicks(value.Ticks, fraction);
+        }
+        base.ConfigureParameter(parameter);
+        // P1 observed Precision=0 unset. Ordinary timestamp mappings retain that state;
+        // DATE explicitly publishes the root-approved Precision0/Scale0 declaration.
+        if (IsDate) parameter.Precision = 0;
+        parameter.Scale = checked((byte)fraction);
+    }
+
+    protected override string GenerateNonNullSqlLiteral(object value)
+    {
+        DamengTemporalParameterFacets.RejectLocalTimezoneLiteral(StoreType);
+        var dateTime = (DateTime)value;
+        var fraction = Fraction;
+        if (!IsDate) return DamengTemporalParameterFacets.TimestampLiteral(dateTime, fraction);
+        DamengTemporalParameterFacets.Midnight(dateTime);
+        DamengTemporalParameterFacets.LiteralDomain(dateTime);
+        return "DATE '" + dateTime.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) + "'";
+    }
+}
