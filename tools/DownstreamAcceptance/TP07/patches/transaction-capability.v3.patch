+using System.Data.Common;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Diagnostics;
+using Microsoft.EntityFrameworkCore.Storage;
+
+namespace W.EntityFrameworkCore.Dameng.Storage.Internal;
+
+internal sealed class DamengRelationalTransactionFactory : RelationalTransactionFactory
+{
+    public DamengRelationalTransactionFactory(RelationalTransactionFactoryDependencies dependencies)
+        : base(dependencies)
+    {
+    }
+
+    public override RelationalTransaction Create(
+        IRelationalConnection connection,
+        DbTransaction transaction,
+        Guid transactionId,
+        IDiagnosticsLogger<DbLoggerCategory.Database.Transaction> logger,
+        bool transactionOwned)
+        => new DamengRelationalTransaction(
+            connection, transaction, transactionId, logger, transactionOwned, Dependencies.SqlGenerationHelper);
+}
