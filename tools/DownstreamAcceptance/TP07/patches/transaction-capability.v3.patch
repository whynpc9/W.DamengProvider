+using System.Collections;
+using System.Data;
+using System.Data.Common;
+using System.Diagnostics.CodeAnalysis;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Infrastructure;
+using Microsoft.EntityFrameworkCore.Storage;
+using Microsoft.EntityFrameworkCore.Update;
+using Microsoft.Extensions.DependencyInjection;
+using W.EntityFrameworkCore.Dameng.Storage.Internal;
+using Xunit;
+
+namespace W.EntityFrameworkCore.Dameng.Tests;
+
+public sealed class DamengRelationalTransactionCapabilityTests
+{
+    private static readonly string[] BatchOnlyOperationEvents = ["batch"];
+    [Theory]
+    [InlineData(false, false, false)]
+    [InlineData(false, false, true)]
+    [InlineData(false, true, false)]
+    [InlineData(false, true, true)]
+    [InlineData(true, false, false)]
+    [InlineData(true, false, true)]
+    [InlineData(true, true, false)]
+    [InlineData(true, true, true)]
+    public async Task BeginTransactionUsesRegisteredFactoryAndPreservesOwnedLifecycle(
+        bool supportsSavepoints, bool async, bool commit)
+    {
+        using var connection = new TestConnection(supportsSavepoints);
+        using var context = Context(connection);
+        // Verify the exact registered provider infrastructure type against EF 10.0.12.
+#pragma warning disable EF1001
+        Assert.IsType<DamengRelationalTransactionFactory>(context.GetService<IRelationalTransactionFactory>());
+#pragma warning restore EF1001
+        // Verify the exact registered provider infrastructure type against EF 10.0.12.
+#pragma warning disable EF1001
+        Assert.IsType<DamengRelationalConnection>(context.GetService<IRelationalConnection>());
+#pragma warning restore EF1001
+        Assert.True(context.Database.AutoSavepointsEnabled);
+        Assert.Equal(AutoTransactionBehavior.WhenNeeded, context.Database.AutoTransactionBehavior);
+
+        var transaction = async
+            ? await context.Database.BeginTransactionAsync(IsolationLevel.ReadCommitted)
+            : context.Database.BeginTransaction(IsolationLevel.ReadCommitted);
+        var underlying = Assert.IsType<TestTransaction>(transaction.GetDbTransaction());
+        // Verify the exact registered provider infrastructure type against EF 10.0.12.
+#pragma warning disable EF1001
+        Assert.IsType<DamengRelationalTransaction>(transaction);
+#pragma warning restore EF1001
+        Assert.Same(connection.LastTransaction, underlying);
+        Assert.Same(connection, underlying.Connection);
+        Assert.Same(transaction, context.Database.CurrentTransaction);
+        Assert.Equal(IsolationLevel.ReadCommitted, underlying.IsolationLevel);
+        Assert.Equal(supportsSavepoints, transaction.SupportsSavepoints);
+        Assert.NotEqual(Guid.Empty, transaction.TransactionId);
+
+        if (commit)
+        {
+            if (async) await transaction.CommitAsync(); else transaction.Commit();
+        }
+        else
+        {
+            if (async) await transaction.RollbackAsync(); else transaction.Rollback();
+        }
+        Assert.Null(context.Database.CurrentTransaction);
+        Assert.Equal(commit ? 1 : 0, underlying.CommitCalls);
+        Assert.Equal(commit ? 0 : 1, underlying.RollbackCalls);
+        if (async) await transaction.DisposeAsync(); else transaction.Dispose();
+        Assert.Equal(1, underlying.DisposeCalls);
+    }
+
+    [Theory]
+    [InlineData(false, false, false)]
+    [InlineData(false, false, true)]
+    [InlineData(false, true, false)]
+    [InlineData(false, true, true)]
+    [InlineData(true, false, false)]
+    [InlineData(true, false, true)]
+    [InlineData(true, true, false)]
+    [InlineData(true, true, true)]
+    public async Task UseTransactionUsesRegisteredFactoryAndPreservesCallerOwnership(
+        bool supportsSavepoints, bool async, bool commit)
+    {
+        using var connection = new TestConnection(supportsSavepoints);
+        connection.Open();
+        using var underlying = Assert.IsType<TestTransaction>(connection.BeginTransaction(IsolationLevel.ReadCommitted));
+        using var context = Context(connection);
+        var id = Guid.NewGuid();
+        var transaction = async
+            ? await context.Database.UseTransactionAsync(underlying, id)
+            : context.Database.UseTransaction(underlying, id);
+        Assert.NotNull(transaction);
+        // Verify the exact registered provider infrastructure type against EF 10.0.12.
+#pragma warning disable EF1001
+        Assert.IsType<DamengRelationalTransactionFactory>(context.GetService<IRelationalTransactionFactory>());
+#pragma warning restore EF1001
+        // Verify the exact registered provider infrastructure type against EF 10.0.12.
+#pragma warning disable EF1001
+        Assert.IsType<DamengRelationalTransaction>(transaction);
+#pragma warning restore EF1001
+        Assert.Equal(id, transaction.TransactionId);
+        Assert.Same(underlying, transaction.GetDbTransaction());
+        Assert.Equal(supportsSavepoints, transaction.SupportsSavepoints);
+
+        if (commit)
+        {
+            if (async) await transaction.CommitAsync(); else transaction.Commit();
+        }
+        else
+        {
+            if (async) await transaction.RollbackAsync(); else transaction.Rollback();
+        }
+        if (async) await transaction.DisposeAsync(); else transaction.Dispose();
+        Assert.Null(context.Database.CurrentTransaction);
+        Assert.Equal(0, underlying.DisposeCalls);
+        Assert.Equal(commit ? 1 : 0, underlying.CommitCalls);
+        Assert.Equal(commit ? 0 : 1, underlying.RollbackCalls);
+    }
