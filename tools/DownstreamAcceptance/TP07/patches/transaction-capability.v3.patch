+    private sealed class TestBatch(TestConnection connection, Exception? failure) : ModificationCommandBatch
+    {
+        public int SyncExecutions { get; private set; }
+        public int AsyncExecutions { get; private set; }
+        public IRelationalConnection? ExecutedConnection { get; private set; }
+        public DbTransaction? ExecutedTransaction { get; private set; }
+        public override IReadOnlyList<IReadOnlyModificationCommand> ModificationCommands => [];
+        public override bool RequiresTransaction => true;
+        public override bool AreMoreBatchesExpected => false;
+        public override bool TryAddCommand(IReadOnlyModificationCommand modificationCommand) => throw new NotSupportedException();
+        public override void Complete(bool moreBatchesExpected) { }
+        public override void Execute(IRelationalConnection relationalConnection)
+        {
+            SyncExecutions++;
+            ExecuteCore(relationalConnection);
+        }
+        public override Task ExecuteAsync(IRelationalConnection relationalConnection, CancellationToken cancellationToken = default)
+        {
+            AsyncExecutions++;
+            ExecuteCore(relationalConnection);
+            return Task.CompletedTask;
+        }
+        private void ExecuteCore(IRelationalConnection relationalConnection)
+        {
+            ExecutedConnection = relationalConnection;
+            ExecutedTransaction = relationalConnection.CurrentTransaction!.GetDbTransaction();
+            connection.OperationEvents.Add("batch");
+            connection.Work++;
+            if (failure != null) throw failure;
+        }
+    }
+
+    private sealed class TestConnection(bool supportsSavepoints) : DbConnection
+    {
+        private ConnectionState _state;
+        public bool SupportsNextTransaction { get; set; } = supportsSavepoints;
+        public TestTransaction? LastTransaction { get; private set; }
+        public ISqlGenerationHelper? Sql { get; set; }
+        public List<string> OperationEvents { get; } = [];
+        public int Work { get; set; } = 1;
+        public int SyncCommands { get; set; }
+        public int AsyncCommands { get; set; }
+        [AllowNull] public override string ConnectionString { get; set; } = string.Empty;
+        public override string Database => "synthetic";
+        public override string DataSource => "synthetic";
+        public override string ServerVersion => "unused";
+        public override ConnectionState State => _state;
+        public override void ChangeDatabase(string databaseName) => throw new NotSupportedException();
+        public override void Open() => _state = ConnectionState.Open;
+        public override Task OpenAsync(CancellationToken cancellationToken) { Open(); return Task.CompletedTask; }
+        public override void Close() => _state = ConnectionState.Closed;
+        protected override DbTransaction BeginDbTransaction(IsolationLevel isolationLevel)
+            => LastTransaction = new TestTransaction(this, isolationLevel, SupportsNextTransaction);
+        protected override DbCommand CreateDbCommand() => new TestCommand(this);
+        public int ExecuteSavepoint(string sql, DbTransaction? transaction)
+        {
+            var active = LastTransaction ?? throw new InvalidOperationException("synthetic_transaction_missing");
+            var helper = Sql ?? throw new InvalidOperationException("synthetic_SQL_helper_missing");
+            Assert.Same(active, transaction);
+            if (!active.SupportsSavepoints) throw new NotSupportedException("synthetic_savepoints_unsupported");
+            if (sql == helper.GenerateCreateSavepointStatement("__EFSavePoint"))
+            {
+                OperationEvents.Add("create"); active.SavepointWork = Work;
+            }
+            else if (sql == helper.GenerateRollbackToSavepointStatement("__EFSavePoint"))
+            {
+                OperationEvents.Add("rollback-to"); Work = active.SavepointWork;
+            }
+            else if (sql == helper.GenerateReleaseSavepointStatement("__EFSavePoint")) OperationEvents.Add("release");
+            else throw new InvalidOperationException("unexpected_synthetic_SQL");
+            return -1;
+        }
+    }
+
+    private sealed class TestTransaction(TestConnection connection, IsolationLevel isolation, bool supports) : DbTransaction
+    {
+        private readonly int _originalWork = connection.Work;
+        private bool _disposed;
+        public int SavepointWork { get; set; }
+        public int CommitCalls { get; private set; }
+        public int RollbackCalls { get; private set; }
+        public int DisposeCalls { get; private set; }
+        public override IsolationLevel IsolationLevel => isolation;
+        public override bool SupportsSavepoints => supports;
+        protected override DbConnection DbConnection => connection;
+        public override void Commit() => CommitCalls++;
+        public override Task CommitAsync(CancellationToken cancellationToken = default) { Commit(); return Task.CompletedTask; }
+        public override void Rollback() { RollbackCalls++; connection.Work = _originalWork; }
+        public override Task RollbackAsync(CancellationToken cancellationToken = default) { Rollback(); return Task.CompletedTask; }
+        protected override void Dispose(bool disposing)
+        {
+            if (disposing && !_disposed) { _disposed = true; DisposeCalls++; }
+            base.Dispose(disposing);
+        }
+    }
