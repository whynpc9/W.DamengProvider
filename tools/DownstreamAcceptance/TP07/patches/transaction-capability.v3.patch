+    [Fact]
+    public void SingletonFactoryUsesEachActualTransactionRatherThanSharedConnectionCapability()
+    {
+        using var services = new ServiceCollection().AddEntityFrameworkDameng().BuildServiceProvider();
+        using var supported = new TestConnection(true);
+        using var unsupported = new TestConnection(false);
+        using var first = Context(supported, services);
+        using var second = Context(unsupported, services);
+        using var firstTransaction = first.Database.BeginTransaction();
+        using var secondTransaction = second.Database.BeginTransaction();
+        Assert.Same(first.GetService<IRelationalTransactionFactory>(), second.GetService<IRelationalTransactionFactory>());
+        Assert.True(firstTransaction.SupportsSavepoints);
+        Assert.False(secondTransaction.SupportsSavepoints);
+        supported.SupportsNextTransaction = false;
+        unsupported.SupportsNextTransaction = true;
+        Assert.True(firstTransaction.SupportsSavepoints);
+        Assert.False(secondTransaction.SupportsSavepoints);
+    }
+
+    [Theory]
+    [InlineData(false, false, false)]
+    [InlineData(false, false, true)]
+    [InlineData(false, true, false)]
+    [InlineData(false, true, true)]
+    [InlineData(true, false, false)]
+    [InlineData(true, false, true)]
+    [InlineData(true, true, false)]
+    [InlineData(true, true, true)]
+    public async Task RealBatchExecutorHonorsCapabilityAndRollsBackOnlyToSupportedSavepoints(
+        bool supportsSavepoints, bool async, bool failBatch)
+    {
+        using var connection = new TestConnection(supportsSavepoints);
+        using var context = Context(connection);
+        connection.Sql = context.GetService<ISqlGenerationHelper>();
+        var transaction = async
+            ? await context.Database.BeginTransactionAsync(IsolationLevel.ReadCommitted)
+            : context.Database.BeginTransaction(IsolationLevel.ReadCommitted);
+        var underlying = Assert.IsType<TestTransaction>(transaction.GetDbTransaction());
+        Assert.True(context.Database.AutoSavepointsEnabled);
+        Assert.Equal(AutoTransactionBehavior.WhenNeeded, context.Database.AutoTransactionBehavior);
+        var executor = context.GetService<IBatchExecutor>();
+        Assert.Equal("Microsoft.EntityFrameworkCore.Update.Internal.BatchExecutor", executor.GetType().FullName);
+        var expectedFailure = new InvalidOperationException("synthetic_batch_failure");
+        var batch = new TestBatch(connection, failBatch ? expectedFailure : null);
+        if (failBatch)
+        {
+            var actual = async
+                ? await Assert.ThrowsAsync<InvalidOperationException>(() => executor.ExecuteAsync([batch], context.GetService<IRelationalConnection>()))
+                : Assert.Throws<InvalidOperationException>(() => executor.Execute([batch], context.GetService<IRelationalConnection>()));
+            Assert.Same(expectedFailure, actual);
+        }
+        else
+        {
+            int count = async
+                ? await executor.ExecuteAsync([batch], context.GetService<IRelationalConnection>())
+                : executor.Execute([batch], context.GetService<IRelationalConnection>());
+            Assert.Equal(0, count); // Test batch has no model commands; its execution changes the synthetic work counter.
+        }
+        Assert.Equal(async ? 0 : 1, batch.SyncExecutions);
+        Assert.Equal(async ? 1 : 0, batch.AsyncExecutions);
+        Assert.Same(context.GetService<IRelationalConnection>(), batch.ExecutedConnection);
+        Assert.Same(underlying, batch.ExecutedTransaction);
+        Assert.Same(transaction, context.Database.CurrentTransaction);
+        Assert.Equal(0, underlying.CommitCalls);
+        Assert.Equal(0, underlying.RollbackCalls);
+        Assert.Equal(0, underlying.DisposeCalls);
+        if (supportsSavepoints)
+        {
+            string[] expectedEvents = failBatch ? ["create", "batch", "rollback-to", "release"] : ["create", "batch", "release"];
+            Assert.Equal(expectedEvents, connection.OperationEvents);
+            Assert.Equal(failBatch ? 1 : 2, connection.Work);
+            Assert.Equal(async ? 0 : (failBatch ? 3 : 2), connection.SyncCommands);
+            Assert.Equal(async ? (failBatch ? 3 : 2) : 0, connection.AsyncCommands);
+        }
+        else
+        {
+            Assert.Equal(BatchOnlyOperationEvents, connection.OperationEvents);
+            Assert.Equal(2, connection.Work);
+            Assert.Equal(0, connection.SyncCommands + connection.AsyncCommands);
+        }
+        if (async) await transaction.RollbackAsync(); else transaction.Rollback();
+        Assert.Equal(1, connection.Work); // A full rollback is still available when savepoints are unsupported.
+        if (async) await transaction.DisposeAsync(); else transaction.Dispose();
+        Assert.Equal(1, underlying.DisposeCalls);
+    }
+
+    private static DbContext Context(TestConnection connection, IServiceProvider? services = null)
+    {
+        var builder = new DbContextOptionsBuilder().UseDameng(connection);
+        if (services != null) builder.UseInternalServiceProvider(services);
+        return new DbContext(builder.Options);
+    }
