<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>W.DmProvider.LegacyCompatibilityProbe</AssemblyName>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <NuGetAudit>false</NuGetAudit>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.3.0</PackageVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(UsePackage)' != 'true'">
    <ProjectReference Include="../../src/W.DamengProvider/W.DamengProvider.csproj" AdditionalProperties="TargetFramework=netstandard2.1" SetTargetFramework="TargetFramework=netstandard2.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackage)' == 'true'">
    <PackageReference Include="W.DamengProvider" Version="[$(PackageVersion)]" />
  </ItemGroup>
</Project>
